<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:paddingTop="12dp">

    <!-- tap: the picture opens big (PhotoViewActivity) -->
    <com.unihub.app.view.AvatarView android:id="@+id/avatar" android:layout_width="56dp"
        android:layout_height="56dp" android:layout_marginEnd="12dp"
        android:contentDescription="Profile picture, tap to enlarge" />

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/tvName" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/ink" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:id="@+id/tvDept" style="@style/BodyText" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:paddingTop="2dp" />
        <TextView android:id="@+id/tvEmail" style="@style/BodyText" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:paddingTop="2dp" />
        <TextView android:id="@+id/tvPhone" style="@style/BodyText" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:paddingTop="2dp" />
        <TextView android:id="@+id/tvSave" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:paddingTop="8dp" android:paddingBottom="2dp" android:text="Save to Contacts"
            android:textColor="@color/blue" android:textSize="14sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
