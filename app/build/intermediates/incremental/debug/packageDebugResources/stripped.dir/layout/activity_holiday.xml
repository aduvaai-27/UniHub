<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <LinearLayout style="@style/Header" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView style="@style/HeaderTitle" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="Holiday and Vacation" />
        <TextView style="@style/HeaderSub" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="Set a holiday or vacation for the whole class" />
    </LinearLayout>
    <TextView android:id="@+id/tvOffline" style="@style/OfflineBar" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="@string/offline_add_bar" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">

            <TextView style="@style/MetaText" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="1. Purpose" android:textStyle="bold" />
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:hint="Purpose (for example: Eid, Winter break)">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etPurpose"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapSentences" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView style="@style/MetaText" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="18dp" android:text="2. One date or a range of dates?" android:textStyle="bold" />
            <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/toggleSpan"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                app:singleSelection="true" app:selectionRequired="true">
                <com.google.android.material.button.MaterialButton android:id="@+id/btnSingle"
                    style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1" android:text="One Date" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnRange"
                    style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1" android:text="Date Range" />
            </com.google.android.material.button.MaterialButtonToggleGroup>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnFrom"
                style="?attr/materialButtonOutlinedStyle" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Select date" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnTo"
                style="?attr/materialButtonOutlinedStyle" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Select end date"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton android:id="@+id/btnSave"
                android:layout_width="match_parent" android:layout_height="52dp"
                android:layout_marginTop="22dp" android:text="Set Holiday" android:textSize="16sp" />

            <TextView android:id="@+id/tvListTitle" style="@style/MetaText" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginTop="28dp"
                android:text="UPCOMING HOLIDAYS" android:textStyle="bold" />
            <TextView android:id="@+id/tvNone" style="@style/MetaText" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:text="Nothing has been set yet." />
            <LinearLayout android:id="@+id/listSet" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
