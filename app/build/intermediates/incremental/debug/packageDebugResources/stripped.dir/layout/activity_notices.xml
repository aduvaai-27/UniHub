<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical">
        <LinearLayout style="@style/Header" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView style="@style/HeaderTitle" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="@string/notices" />
            <TextView android:id="@+id/tvSub" style="@style/HeaderSub" android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
        <TextView android:id="@+id/tvOffline" style="@style/OfflineBar" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/offline_notices_bar" />
        <TextView android:id="@+id/tvEmpty" style="@style/MetaText" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:gravity="center" android:padding="32dp"
            android:text="@string/no_notices_have_been_posted" android:textSize="15sp" android:visibility="gone" />
        <!-- ListView: padding + dividerHeight reproduce the card spacing -->
        <ListView android:id="@+id/list"
            android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:clipToPadding="false" android:scrollbars="none"
            android:divider="@android:color/transparent" android:dividerHeight="12dp"
            android:listSelector="@android:color/transparent"
            android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="16dp" android:paddingBottom="96dp" />
    </LinearLayout>
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabPost" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="bottom|end" android:layout_margin="20dp" android:text="@string/post_notice"
        android:textColor="@color/white" app:backgroundTint="?attr/colorPrimary" android:visibility="gone" />
</FrameLayout>
