<?xml version="1.0" encoding="utf-8"?>
<!-- RelativeLayout: the Delete label is pinned to the end of the card, the text block sits to its start. -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_margin="6dp" android:background="@drawable/bg_card">
    <TextView android:id="@+id/btnDelete" style="@style/DeleteText" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_alignParentEnd="true"
        android:text="@string/delete" android:visibility="gone" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_toStartOf="@id/btnDelete"
        android:orientation="vertical" android:padding="16dp">
        <TextView android:id="@+id/tvTitle" style="@style/TitleText"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/tvBody" style="@style/BodyText"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" />
        <TextView android:id="@+id/tvMeta" style="@style/MetaText"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" />
    </LinearLayout>
</RelativeLayout>
