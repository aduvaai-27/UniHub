<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_margin="6dp" android:background="@drawable/bg_card">
    <View android:id="@+id/strip" android:layout_width="5dp" android:layout_height="match_parent" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:orientation="vertical" android:padding="14dp">
        <TextView android:id="@+id/tvCourse" style="@style/TagText"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/tvTitle" style="@style/TitleText"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" />
        <TextView android:id="@+id/tvDetails" style="@style/BodyText"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:gravity="center_vertical">
            <TextView android:id="@+id/tvDue" style="@style/MetaText" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1" />
            <TextView android:id="@+id/tvCountdown" style="@style/TagText"
                android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/btnDelete" style="@style/DeleteText" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text="@string/delete" android:visibility="gone" />
</LinearLayout>
