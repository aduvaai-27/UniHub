    <style name="BodyText">
        <item name="android:textColor">@color/body</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="Card">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">16dp</item>
    </style>
    <style name="DeleteText">
        <item name="android:textColor">@color/danger</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:padding">12dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="Header">
        <item name="android:background">@color/navy</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingTop">36dp</item>
        <item name="android:paddingBottom">20dp</item>
    </style>
    <style name="HeaderSub">
        <item name="android:textColor">#CFE0F2</item>
        <item name="android:textSize">13sp</item>
    </style>
    <style name="HeaderTitle">
        <item name="android:fontFamily">serif</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="MetaText">
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">13sp</item>
    </style>
    <style name="OfflineBar">
        <item name="android:background">@color/danger</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:visibility">gone</item>
    </style>
    <style name="TagText">
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Theme.UniHub" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/navy</item>
        <item name="colorPrimaryVariant">@color/navy_dark</item>
        <item name="colorSecondary">@color/blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSurface">@color/card</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:statusBarColor">@color/navy_dark</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="materialButtonStyle">@style/Widget.UniHub.Button</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
    <style name="TitleText">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Widget.UniHub.Button" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">4dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>
